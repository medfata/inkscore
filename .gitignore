# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/indexer/node_modules
/indexer/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/api-server/node_modules
/api-server/.env
/api-server/dist
/.kiro
/.vscode

# session artifacts (do not commit)
.codex-logs/
api-server/dev-server.log
/nul
nul
scripts/admin-mint.zip

# generated gif demos (do not commit)
/excalidraw_gif/
/output_gif/
excalidraw_gif/node_modules/

backfill/*.log
